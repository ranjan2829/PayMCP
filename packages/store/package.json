{
  "name": "@paymcp/store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Paid-agent-tools mini marketplace \u2014 Stripe funding, credit ledger, seller USDC payout on settle",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "paymcp-store": "./bin/paymcp-store.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "fixtures",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "tsx src/cli/run.ts serve",
    "cli": "tsx src/cli/run.ts",
    "seed": "tsx src/cli/run.ts seed"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "openapi-to-paymcp": "workspace:*",
    "zod": "^3.24.2",
    "js-yaml": "^4.1.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "@types/js-yaml": "^4.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
