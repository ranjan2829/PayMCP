{
  "name": "paymcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Turn an OpenAPI spec into a paid MCP server (x402 settlement)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "demo": "pnpm --filter @paymcp/demo-api demo",
    "lint:types": "pnpm --filter openapi-to-paymcp typecheck",
    "paymcp": "node ./packages/paymcp/bin/paymcp.js",
    "publish:paymcp": "pnpm --filter openapi-to-paymcp publish --access public",
    "live:settle": "node ./scripts/live-settle.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "openapi-to-paymcp": "workspace:*"
  }
}
