# PayMCP / PayMCP Store — environment variable NAMES only.
# Copy to .env and set real values locally. Never commit .env or paste secrets here.
# Fail closed: required vars must be set in the environment before live serve/settle.

# ─── Required for real facilitator settlement (openapi-to-paymcp / demo-api) ─
# PAYMCP_FACILITATOR_URL
# PAYMCP_PAY_TO
# PAYMCP_NETWORK
# PAYMCP_ASSET
# Public Base Sepolia defaults operators often use:
#   facilitator https://x402.org/facilitator
#   network eip155:84532
#   USDC 0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Base mainnet (CDP facilitator) ─────────────────────────────────────────
# PAYMCP_FACILITATOR_URL
# PAYMCP_NETWORK
# PAYMCP_ASSET
# PAYMCP_FACILITATOR_AUTH_TOKEN
# CDP_API_KEY_ID
# CDP_API_KEY_SECRET

# ─── Optional PayMCP ────────────────────────────────────────────────────────
# PAYMCP_ASSET_NAME
# PAYMCP_MAX_TIMEOUT_SECONDS
# PAYMCP_SCHEME
# PAYMCP_LEDGER_PATH
# PAYMCP_DATABASE_URL
# PAYMCP_FACILITATOR_TIMEOUT_MS
# PAYMCP_FACILITATOR_MAX_RETRIES
# PAYMCP_RATE_LIMIT_MAX
# PAYMCP_RATE_LIMIT_WINDOW_MS

# ─── Demo API / live settle ─────────────────────────────────────────────────
# PORT
# HOST
# LOG_LEVEL
# PAYMCP_LIVE
# DEMO_API_URL
# PAYMENT_SIGNATURE_B64
# EVM_PRIVATE_KEY

# ─── Buyer example (@x402/fetch) ────────────────────────────────────────────
# Probe (no funds): pnpm buyer:probe
# Pay (spends USDC): PAYMCP_LIVE=1 + EVM_PRIVATE_KEY in env, then pnpm buyer:example
# PAYMCP_LIVE
# EVM_PRIVATE_KEY
# DEMO_API_URL
# PAYMCP_BUYER_PATH
# PAYMCP_BUYER_METHOD
# PAYMCP_BUYER_BODY
# PAYMCP_BUYER_MAX_AMOUNT
# PAYMCP_FACILITATOR_URL

# ─── Allowlist + per-tool budgets ───────────────────────────────────────────
# PAYMCP_ALLOWLIST
# PAYMCP_DEFAULT_MAX_DAILY_ATOMIC
# PAYMCP_BUDGET_WINDOW
# PAYMCP_BUDGETS_PATH

# ─── Dispute / evidence packs ───────────────────────────────────────────────
# PAYMCP_DISPUTE_HMAC_SECRET

# ─── Settlement webhooks (billing) ──────────────────────────────────────────
# Signature header: X-PayMCP-Signature: sha256=<HMAC-SHA256 hex of raw body>
# PAYMCP_WEBHOOK_URL
# PAYMCP_WEBHOOK_SECRET
# PAYMCP_WEBHOOK_TIMEOUT_MS
# PAYMCP_WEBHOOK_MAX_RETRIES

# ─── PayMCP Store (@paymcp/store) ───────────────────────────────────────────
# STORE_HOST
# STORE_PORT
# STORE_DB_PATH
# STORE_PUBLIC_BASE_URL
# STORE_SEED_NETWORK
# STORE_SEED_PAY_TO          # required for seed/serve auto-seed (real EVM address)
# STORE_REQUIRE_PAYOUT       # "1" (default) requires operator payout env for serve
#
# Stripe fiat → credits (required to enable POST /v1/funding/checkout + webhook):
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_SUCCESS_URL
# STRIPE_CANCEL_URL
#
# Seller payout on invoke settle (USDC transfer to listing.payTo):
# STORE_OPERATOR_PRIVATE_KEY
# STORE_RPC_URL
# PAYMCP_ASSET
# PAYMCP_FACILITATOR_URL
# PAYMCP_FACILITATOR_AUTH_TOKEN
# PAYMCP_ASSET_NAME

# ─── Live Base receipt demo (@paymcp/store) ─────────────────────────────────
# seed-live / public receipts — fail closed without real values:
# STORE_SEED_PAY_TO
# STORE_SEED_NETWORK          # default eip155:84532 (Base Sepolia); mainnet eip155:8453
# PAYMCP_ASSET
# PAYMCP_FACILITATOR_URL
# STORE_PUBLIC_BASE_URL       # absolute receipt URLs (e.g. http://127.0.0.1:8790)
# STORE_LIVE_UPSTREAM_BASE_URL  # optional; defaults to local demo-api
# STORE_OPERATOR_PRIVATE_KEY
# STORE_RPC_URL

# ─── Visa TAP + VIC dual rail (openapi-to-paymcp) ───────────────────────────
# TAP authenticates the agent (RFC 9421); it does not move money alone.
# PAYMCP_TAP_REQUIRED
# PAYMCP_TAP_JWKS_URL
# PAYMCP_TAP_JWKS_PATH
# PAYMCP_TAP_MAX_WINDOW_SECONDS
#
# Visa Intelligent Commerce settler (fail closed when enabled without secrets):
# PAYMCP_VISA_ENABLED
# VISA_API_BASE_URL
# VISA_API_KEY
# VISA_SHARED_SECRET
# VISA_KEY_ID
# VISA_MERCHANT_ID
# VISA_SETTLE_PATH
# VISA_VERIFY_PATH
# PAYMCP_VISA_TIMEOUT_MS
# PAYMCP_VISA_MAX_RETRIES
#
# Listing / paywall rail preference: x402 | visa | auto (code/config, not env).
