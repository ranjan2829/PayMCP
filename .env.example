# ─── Required for real facilitator settlement ───────────────────────────────
PAYMCP_FACILITATOR_URL=https://x402.org/facilitator
PAYMCP_PAY_TO=0xYourRecipientAddress
PAYMCP_NETWORK=eip155:84532
PAYMCP_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Base mainnet (CDP facilitator) ─────────────────────────────────────────
# PAYMCP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# PAYMCP_NETWORK=eip155:8453
# PAYMCP_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# PAYMCP_FACILITATOR_AUTH_TOKEN=Bearer eyJ...
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────
# PAYMCP_ASSET_NAME=USDC
# PAYMCP_MAX_TIMEOUT_SECONDS=60
# PAYMCP_SCHEME=exact
# PAYMCP_LEDGER_PATH=./paymcp-ledger.db
# PAYMCP_DATABASE_URL=postgres://paymcp:paymcp@localhost:5432/paymcp
# PAYMCP_FACILITATOR_TIMEOUT_MS=15000
# PAYMCP_FACILITATOR_MAX_RETRIES=2
# PAYMCP_RATE_LIMIT_MAX=60
# PAYMCP_RATE_LIMIT_WINDOW_MS=60000

# ─── Demo API / live settle ─────────────────────────────────────────────────
# PORT=8787
# HOST=0.0.0.0
# LOG_LEVEL=info
# PAYMCP_LIVE=0
# DEMO_API_URL=http://127.0.0.1:8787
# PAYMENT_SIGNATURE_B64=
# EVM_PRIVATE_KEY=

# ─── Buyer example (@x402/fetch) ────────────────────────────────────────────
# Example only — not a new protocol. wrapFetchWithPayment pays a local PayMCP
# 402 route. The facilitator URL is used by the *server*, not this client.
# Probe (no funds): pnpm buyer:probe
# Pay (spends USDC): PAYMCP_LIVE=1 EVM_PRIVATE_KEY=0x... pnpm buyer:example
# Set PAYMCP_ASSET_NAME=USDC on the server so ExactEvmScheme can sign EIP-3009.
# PAYMCP_LIVE=1
# EVM_PRIVATE_KEY=0xYourPayerPrivateKey
# DEMO_API_URL=http://127.0.0.1:8787
# PAYMCP_BUYER_PATH=/echo
# PAYMCP_BUYER_METHOD=POST
# PAYMCP_BUYER_BODY={"message":"hello from @x402/fetch"}
# PAYMCP_BUYER_MAX_AMOUNT=$1
# PAYMCP_FACILITATOR_URL=https://x402.org/facilitator

# ─── Allowlist + per-tool budgets ───────────────────────────────────────────
# PAYMCP_ALLOWLIST=echoMessage,getWeather
# PAYMCP_DEFAULT_MAX_DAILY_ATOMIC=100000
# PAYMCP_BUDGET_WINDOW=calendar_day_utc
# PAYMCP_BUDGETS_PATH=./budgets.yaml

# ─── Dispute / evidence packs ───────────────────────────────────────────────
# HMAC-SHA256 secret for `paymcp dispute-pack` / exportDisputePack (≥16 chars).
# PAYMCP_DISPUTE_HMAC_SECRET=

# ─── Settlement webhooks (billing) ──────────────────────────────────────────
# After a successful settle (2xx path only), POST a signed event to billing.
# Signature header: X-PayMCP-Signature: sha256=<HMAC-SHA256 hex of raw body>
# Payload: operationId, amount, network, asset, payer, transaction, idempotencyKey,
# settledAt, optional requestId — never includes PAYMENT-SIGNATURE secrets.
# PAYMCP_WEBHOOK_URL=https://billing.example/webhooks/paymcp
# PAYMCP_WEBHOOK_SECRET=replace-with-long-random-secret
# PAYMCP_WEBHOOK_TIMEOUT_MS=5000
# PAYMCP_WEBHOOK_MAX_RETRIES=2

# ─── PayMCP Store (@paymcp/store) ───────────────────────────────────────────
# Mini marketplace: listings + buyer credit ledger + invoke gateway.
# Docs: packages/store/README.md
# STORE_HOST=127.0.0.1
# STORE_PORT=8790
# STORE_DB_PATH=./paymcp-store.db
# STORE_PUBLIC_BASE_URL=http://127.0.0.1:8790
# STORE_SEED_NETWORK=eip155:84532
# STORE_SEED_PAY_TO=0x0000000000000000000000000000000000000001
# Optional: fire PayMCP settlement.succeeded webhook when credit debit settles
# PAYMCP_WEBHOOK_URL=https://billing.example/webhooks/paymcp
# PAYMCP_WEBHOOK_SECRET=replace-with-long-random-secret
